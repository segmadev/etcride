# Copy this file to key.properties and fill in your values.
# NEVER commit key.properties to git — it contains secrets.
#
# How to generate a keystore (run once, keep the .jks file safe forever):
#   keytool -genkey -v -keystore etcride-driver.jks -keyalg RSA -keysize 2048 -validity 10000 -alias etcride-driver
#
# Place etcride-driver.jks in the android/ folder (same folder as this file),
# then fill in the values below.

storeFile=etcride-driver.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=etcride-driver
keyPassword=YOUR_KEY_PASSWORD
